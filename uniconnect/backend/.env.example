# ────────────────────────────────────────────────────────────────────────────
# UniConnect Backend — Environment Variable Template
# Copy this file to `.env` and fill in your own values.
# NEVER commit `.env` to version control.
# ────────────────────────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development

# ── JWT Secret ───────────────────────────────────────────────────────────────
# REQUIRED. Must be at least 32 characters (64+ hex chars recommended).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_CRYPTO_RANDOM_HEX_64_CHARS

# ── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Demo Mode ────────────────────────────────────────────────────────────────
# Set to true ONLY during local development (exposes OTP in API response).
# Set to false in staging and production.
DEMO_MODE=true

# ── Body Size Limit ──────────────────────────────────────────────────────────
MAX_BODY_SIZE=10kb
